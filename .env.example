# Переименуйте файл в .env и укажите параметры своего PostgreSQL
PORT=3000
PGHOST=localhost
PGPORT=5432
PGDATABASE=forma_store
PGUSER=postgres
PGPASSWORD=your_password
SESSION_SECRET=replace_with_a_long_random_secret
# Для облачного PostgreSQL (например, Neon) можно вместо PG* настроек указать:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
